APP_ENV=development
# Swagger UI at /docs (default: on in development, off in production)
# ENABLE_DOCS=false

POSTGRES_DB=focus_day
POSTGRES_USER=focus_day
POSTGRES_PASSWORD=replace-with-a-long-database-password

DATABASE_URL=postgresql+asyncpg://focus_day:replace-with-a-long-database-password@db:5432/focus_day
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://..../auth/google/callback
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
# Short-lived: logout revokes the refresh token, but an issued access token stays valid until it expires
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
# Extra browser origins allowed to call the API with cookies (comma-separated, https only in production).
# Leave empty when the site is served through the bundled nginx/Vite proxy (same origin).
# Cookies are SameSite=lax/strict, so a cross-site frontend must use the Bearer token instead.
CORS_ORIGINS=
# Fernet key for integration credentials (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# If empty, a key is derived from SECRET_KEY — changing SECRET_KEY then invalidates saved credentials.
INTEGRATIONS_ENCRYPTION_KEY=
# AES-256 key for personal data in the database: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Back it up: without it the data cannot be read. If empty, a key derived from SECRET_KEY is used.
DATA_ENCRYPTION_KEY=
# Previous keys (comma-separated) that may still be needed to decrypt after a rotation
DATA_ENCRYPTION_OLD_KEYS=
DEFAULT_TIMEZONE=Europe/Moscow
# Shared secret between the backend and the Telegram bot (same value in tg_bot/.env)
BOT_API_TOKEN=replace-with-a-random-secret
# Bot username without @, used for the t.me deep link
TELEGRAM_BOT_USERNAME=
# Public https address of the site, used for "Открыть в Dayla" buttons in the bot (empty: hidden)
PUBLIC_APP_URL=
STORAGE_PATH=/app/storage
MAX_FILE_SIZE_MB=20
SBER_AUTHORIZATION_KEY=
SBER_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# GigaChat TLS is verified with the bundled backend/certs/russian_trusted_root_ca.pem.
# Set only to use a different CA file.
GIGACHAT_CA_BUNDLE=
# Whether integrations (Jira, CalDAV) may call private or loopback addresses.
# Default: true in development, false in production.
# ALLOW_PRIVATE_INTEGRATION_URLS=false
